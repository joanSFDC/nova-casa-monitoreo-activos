<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Bandas_cruzadas</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  NOT(ISBLANK(Advertencia_Bajo__c)),
  NOT(ISBLANK(Advertencia_Alto__c)),
  Advertencia_Bajo__c &gt;= Advertencia_Alto__c
)</errorConditionFormula>
    <errorDisplayField>Advertencia_Bajo__c</errorDisplayField>
    <errorMessage
  >La advertencia baja debe ser menor que la advertencia alta.</errorMessage>
</ValidationRule>
